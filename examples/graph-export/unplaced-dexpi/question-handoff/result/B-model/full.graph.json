      "data_requests": [
        {
          "item": "Existing valve/loop feedback and diagnostic records",
          "state": "not_on_drawing",
          "where": [
            "DCS/PLC configuration: approved existing valve/positioner configuration and point definitions for each named valve and loop",
            "maintenance records: existing valve, positioner and calibration records",
            "site records: approved loop drawings, I/O mappings, source revisions and locators"
          ],
          "how": "For each named valve/loop, review the record target, revision/locator, declared signal function, units, enabled return path and diagnostic capability. Keep command/current/travel setpoint separate from measured stem or shaft travel; local positioner feedback does not establish control-room or historian availability. Nearby Z tags and shared unit/stream membership do not establish valve association. Acknowledge appropriate existing coverage, including endpoint indication for an on/off duty, and retain unresolved source questions. Supplied fields do not complete this review.",
          "candidate_scope": "anchors",
          "candidate_facts": []
        },
        {
          "item": "Existing valve performance and diagnostic history",
          "state": "not_on_drawing",
          "where": [
            "historian or DCS trend for FV-04 (no historian tag is mapped in this model for these)",
            "maintenance records: existing diagnostic, inspection and work-order reports for the named valve",
            "site records: previously acquired command, measured-travel and process-response history with its operating basis"
          ],
          "how": "Review available history first. Retain valve/loop identity, source revision/locator, time and operating conditions, enabled state, quality/calibration and readability. Where suitable, compare command, independently described travel and process response over coincident periods. Position indication, endpoint states or oscillation alone do not diagnose stiction or its cause. Keep disabled, bad-quality, unavailable, foreign and unknown records as qualified candidates; ask the responsible record owner for the missing basis. This screen specifies no new manual step test, loop-mode change or operating experiment.",
          "candidate_scope": "anchors",
          "candidate_facts": []
        }
      ],
      "decision_rule": "Record appropriate existing feedback/diagnostics as coverage with its source scope and remaining gaps. Route a named valve/loop request to the responsible record owner where function, association, availability or performance evidence is unresolved. Configuration, tuning, process and assembly causes remain open when investigating reported behavior. Any further test or change requires a separate company-approved method and operating/outage decision; this finding prescribes no retrofit, retune, new connection or mode change.",
      "typical_benefit": {
        "wording": "S13 discusses backlash/stiction and variability in highly throttled/oversized pumping systems, not a universal feedback retrofit. S29-S32 distinguish feedback routes and vendor-specific diagnostic/history examples. They establish no quantified benefit for this investigation or the supplied plant.",
        "source": [
          "S13",
          "S29",
          "S30",
          "S31",
          "S32"
        ],
        "arc": null,
        "source_titles": [
          "S13: Improving Pumping System Performance: A Sourcebook for Industry, 2nd ed. (DOE + Hydraulic Institute; DOE/GO-102006-2079)",
          "S29: Emerson Automation Experts, Providing Operators Process Control Valve Position Feedback (2014-01-10; vendor guidance)",
          "S30: Emerson, Valve Positioners (product overview and digital-controller FAQ; vendor-specific)",
          "S31: Emerson, Control Valve Diagnostics (product capabilities and status monitor; vendor-specific)",
          "S32: Emerson Automation Experts, Impacts of Control Valve Diagnostics (2011-02-14; vendor guidance)"
        ]
      },
      "limits": "P&IDs can omit fitted positioners. Drawing omission, local feedback, an enabled control-room return, historian availability and verified plant conditions are separate claims. Discrete endpoint feedback is not a continuous travel trace and is not automatically unsuitable for an on/off duty. Supplied source/quality flags and reported abnormalities are unverified evidence, not installed-state checks, unique diagnoses or permission to test/change equipment.",
      "status": "asked"
    }
